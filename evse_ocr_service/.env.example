# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_V1_STR=/api/v1
PROJECT_NAME="EVSE OCR Recovery Service"

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/evse_ocr_db
DATABASE_TEST_URL=sqlite:///./test.db

# Storage Configuration ('local' or 's3')
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./data/raw
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=evse-scan-telemetry
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-central-1

# Model & Inference Parameters
MODEL_CHECKPOINT=microsoft/trocr-base-printed
MODEL_MAX_LENGTH=40
MODEL_NUM_BEAMS=5
MODEL_NO_REPEAT_NGRAM_SIZE=3
MODEL_DEVICE=auto

# Geospatial & Active Learning Thresholds
CONFIDENCE_THRESHOLD=0.85
SPATIAL_VALIDATION_RADIUS_KM=0.5
